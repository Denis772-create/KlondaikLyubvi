@page "/calendar"
@inject HttpClient Http
@inject IJSRuntime JS

@code {
    class CalendarEventDto
    {
        public int Id { get; set; }
        public DateTime Date { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Emoji { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty;
        public string? Description { get; set; }
    }

    int UserId = 0;
    DateTime CurrentDate = DateTime.Today;
    List<CalendarEventDto> Events = new();
    string? Error;
    string? Success;
    
    // Модальное окно
    bool ShowAddEventModal = false;
    CalendarEventDto NewEvent = new() { Date = DateTime.Today.AddDays(1) };
    
    // Важные даты
    Dictionary<string, DateTime> ImportantDates = new()
    {
        ["💕 День знакомства"] = new DateTime(2020, 3, 15), // Пример
        ["💍 Помолвка"] = new DateTime(2021, 12, 25), // Пример
        ["🎂 День рождения Дениса"] = new DateTime(1990, 8, 15), // Пример
        ["🎂 День рождения Лизы"] = new DateTime(1992, 5, 20), // Пример
        ["💒 Годовщина"] = new DateTime(2022, 6, 10) // Пример
    };

    protected override async Task OnInitializedAsync()
    {
        var userIdStr = await JS.InvokeAsync<string>("blazorGetCookie", "userId");
        int.TryParse(userIdStr, out UserId);
        await LoadEvents();
    }

    async Task LoadEvents()
    {
        try
        {
            var year = CurrentDate.Year;
            var month = CurrentDate.Month;
            Events = await Http.GetFromJsonAsync<List<CalendarEventDto>>($"/api/calendar/{UserId}?year={year}&month={month}") ?? new();
            
            // Добавляем важные даты для текущего месяца
            AddImportantDatesForMonth();
        }
        catch (Exception ex)
        {
            Error = $"Ошибка загрузки событий: {ex.Message}";
        }
    }

    void AddImportantDatesForMonth()
    {
        foreach (var importantDate in ImportantDates)
        {
            // Проверяем, есть ли эта дата в текущем месяце (любого года)
            if (importantDate.Value.Month == CurrentDate.Month)
            {
                var thisYearDate = new DateTime(CurrentDate.Year, importantDate.Value.Month, importantDate.Value.Day);
                
                // Добавляем только если еще не добавлено
                if (!Events.Any(e => e.Date.Date == thisYearDate.Date && e.Title == importantDate.Key))
                {
                    Events.Add(new CalendarEventDto
                    {
                        Id = -1, // Специальный ID для важных дат
                        Date = thisYearDate,
                        Title = importantDate.Key,
                        Emoji = importantDate.Key.Split(' ')[0],
                        Type = "important",
                        Description = GetAnniversaryText(importantDate.Value, thisYearDate)
                    });
                }
            }
        }
        
        Events = Events.OrderBy(e => e.Date).ToList();
    }

    string GetAnniversaryText(DateTime originalDate, DateTime thisYearDate)
    {
        var years = thisYearDate.Year - originalDate.Year;
        if (years > 0)
            return $"{years} {GetYearWord(years)} вместе";
        return "Особенный день";
    }

    string GetYearWord(int years)
    {
        if (years % 10 == 1 && years % 100 != 11) return "год";
        if (years % 10 >= 2 && years % 10 <= 4 && (years % 100 < 10 || years % 100 >= 20)) return "года";
        return "лет";
    }

    async Task PreviousMonth()
    {
        CurrentDate = CurrentDate.AddMonths(-1);
        await LoadEvents();
    }

    async Task NextMonth()
    {
        CurrentDate = CurrentDate.AddMonths(1);
        await LoadEvents();
    }

    void OpenAddEventModal()
    {
        NewEvent = new CalendarEventDto { Date = DateTime.Today.AddDays(1), Type = "personal" };
        Error = null;
        ShowAddEventModal = true;
    }

    async Task AddEvent()
    {
        Error = null;
        Success = null;
        
        if (string.IsNullOrWhiteSpace(NewEvent.Title))
        {
            Error = "Введите название события";
            return;
        }

        try
        {
            var response = await Http.PostAsJsonAsync("/api/calendar/events", new
            {
                UserId,
                NewEvent.Title,
                NewEvent.Date,
                NewEvent.Emoji,
                NewEvent.Type,
                NewEvent.Description
            });

            if (response.IsSuccessStatusCode)
            {
                Success = "Событие добавлено!";
                ShowAddEventModal = false;
                await LoadEvents();
            }
            else
            {
                Error = "Ошибка добавления события";
            }
        }
        catch (Exception ex)
        {
            Error = $"Ошибка: {ex.Message}";
        }
    }

    async Task DeleteEvent(int eventId)
    {
        try
        {
            var response = await Http.DeleteAsync($"/api/calendar/events/{eventId}");
            if (response.IsSuccessStatusCode)
            {
                Success = "Событие удалено!";
                await LoadEvents();
            }
            else
            {
                Error = "Ошибка удаления события";
            }
        }
        catch (Exception ex)
        {
            Error = $"Ошибка: {ex.Message}";
        }
    }

    async Task GoToToday()
    {
        CurrentDate = DateTime.Today;
        await LoadEvents();
    }

    List<CalendarEventDto> GetEventsForDay(DateTime day)
    {
        return Events.Where(e => e.Date.Date == day.Date).ToList();
    }

    string GetDayClasses(DateTime day)
    {
        var classes = "w-full h-20 p-1 border border-gray-200 transition-colors hover:bg-pink-50 cursor-pointer";
        
        if (day.Month != CurrentDate.Month)
            classes += " bg-gray-50 text-gray-400";
        else if (day.Date == DateTime.Today)
            classes += " bg-pink-100 border-pink-300 font-bold";
        else
            classes += " bg-white";
            
        if (GetEventsForDay(day).Any())
            classes += " border-purple-300 bg-purple-50";
            
        return classes;
    }
}

<div class="bg-gradient-to-br from-rose-50 via-pink-50 to-purple-100 min-h-screen py-6 px-4 font-sans">
    <div class="max-w-6xl mx-auto">
        <!-- Заголовок -->
        <div class="text-center mb-8">
            <div class="flex items-center justify-center gap-3 mb-4">
                <span class="text-4xl animate-pulse">📅</span>
                <h1 class="text-3xl sm:text-4xl font-extrabold bg-gradient-to-r from-pink-600 to-purple-600 bg-clip-text text-transparent">
                    Календарь Любви
            </h1>
                <span class="text-4xl animate-pulse">💕</span>
            </div>
            <p class="text-gray-600 mb-4 text-sm sm:text-base">Важные даты и романтические события</p>
            <button @onclick="OpenAddEventModal" class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-xl font-semibold transition flex items-center gap-2 mx-auto">
                ➕ Добавить событие
            </button>
        </div>

        <!-- Уведомления -->
        @if (!string.IsNullOrEmpty(Success))
        {
            <div class="mb-6 p-4 bg-green-100 border border-green-300 text-green-700 rounded-xl flex justify-between items-center">
                <span>@Success</span>
                <button @onclick="() => Success = null" class="text-green-500 hover:text-green-700">✕</button>
        </div>
        }
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="mb-6 p-4 bg-red-100 border border-red-300 text-red-700 rounded-xl flex justify-between items-center">
                <span>@Error</span>
                <button @onclick="() => Error = null" class="text-red-500 hover:text-red-700">✕</button>
            </div>
        }

        <!-- Навигация по месяцам -->
        <div class="bg-white/80 backdrop-blur-md rounded-2xl shadow-xl p-6 mb-8">
            <div class="flex items-center justify-between mb-6">
                <button @onclick="PreviousMonth" class="p-2 rounded-lg bg-pink-100 hover:bg-pink-200 text-pink-600 transition">
                    ← Предыдущий
                </button>
                
                <div class="text-center">
                    <h2 class="text-2xl font-bold text-gray-800">@CurrentDate.ToString("MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))</h2>
                    <button @onclick="GoToToday" class="text-sm text-pink-600 hover:text-pink-800 transition">
                        Сегодня
                    </button>
                </div>
                
                <button @onclick="NextMonth" class="p-2 rounded-lg bg-pink-100 hover:bg-pink-200 text-pink-600 transition">
                    Следующий →
                </button>
            </div>

            <!-- Календарная сетка -->
            <div class="grid grid-cols-7 gap-1 mb-4">
                <!-- Заголовки дней недели -->
                @foreach (var dayName in new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" })
                {
                    <div class="text-center font-semibold text-gray-600 py-2">@dayName</div>
                }
                
                <!-- Дни месяца -->
                @{
                    var firstDay = new DateTime(CurrentDate.Year, CurrentDate.Month, 1);
                    var startDate = firstDay.AddDays(-(int)firstDay.DayOfWeek + 1);
                    if (firstDay.DayOfWeek == DayOfWeek.Sunday) startDate = startDate.AddDays(-7);
                }
                
                @for (int i = 0; i < 42; i++)
                {
                    var day = startDate.AddDays(i);
                    var dayEvents = GetEventsForDay(day);
                    
                    <div class="@GetDayClasses(day)">
                        <div class="text-sm font-medium">@day.Day</div>
                        @if (dayEvents.Any())
                        {
                            <div class="space-y-1 mt-1">
                                @foreach (var evt in dayEvents.Take(2))
                                {
                                    <div class="text-xs p-1 rounded @(evt.Type == "important" ? "bg-pink-200 text-pink-800" : evt.Type == "exchange" ? "bg-purple-200 text-purple-800" : "bg-blue-200 text-blue-800") truncate">
                                        @evt.Emoji @evt.Title
                    </div>
                }
                                @if (dayEvents.Count > 2)
                                {
                                    <div class="text-xs text-gray-500">+@(dayEvents.Count - 2) еще</div>
                                }
                        </div>
                        }
                    </div>
                }
    </div>
</div>

        <!-- Список событий месяца -->
        <div class="bg-white/80 backdrop-blur-md rounded-2xl shadow-xl p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                📋 События месяца
            </h3>
            
            @if (Events.Any())
            {
                <div class="space-y-4">
                    @foreach (var evt in Events.OrderBy(e => e.Date))
                    {
                        var isToday = evt.Date.Date == DateTime.Today;
                        var isPast = evt.Date.Date < DateTime.Today;
                        
                        <div class="flex items-center gap-4 p-4 rounded-xl @(isToday ? "bg-pink-100 border-2 border-pink-300" : isPast ? "bg-gray-50" : "bg-white border border-gray-200") shadow-sm">
                            <div class="flex-shrink-0">
                                <div class="w-12 h-12 rounded-full @(evt.Type == "important" ? "bg-pink-200" : evt.Type == "exchange" ? "bg-purple-200" : "bg-blue-200") flex items-center justify-center text-xl">
                                    @evt.Emoji
                                </div>
                            </div>
                            
                        <div class="flex-1">
                                <div class="font-semibold text-gray-800 @(isToday ? "text-pink-800" : "")">@evt.Title</div>
                                <div class="text-sm text-gray-600">@evt.Date.ToString("dd MMMM yyyy, dddd", new System.Globalization.CultureInfo("ru-RU"))</div>
                                @if (!string.IsNullOrEmpty(evt.Description))
                                {
                                    <div class="text-sm text-gray-500 mt-1">@evt.Description</div>
                                    }
                        </div>
                            
                            @if (isToday)
                            {
                                <div class="flex-shrink-0">
                                    <span class="bg-pink-500 text-white px-3 py-1 rounded-full text-sm font-semibold">Сегодня</span>
                    </div>
                }
                            </div>
                        }
                </div>
            }
            else
            {
                <div class="text-center py-12 text-gray-500">
                    <div class="text-6xl mb-4">📅</div>
                    <h3 class="text-xl font-semibold text-gray-700 mb-2">Нет событий</h3>
                    <p class="text-gray-500">В этом месяце пока нет запланированных событий</p>
                </div>
            }
        </div>

    </div>
</div>

<!-- Модальное окно добавления события -->
@if (ShowAddEventModal)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50" @onclick="() => ShowAddEventModal = false">
        <div class="bg-white rounded-2xl p-6 max-w-md w-full" @onclick:stopPropagation="true">
            <h3 class="text-xl font-bold text-gray-800 mb-4">Добавить событие</h3>
            
            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="mb-4 p-3 bg-red-100 border border-red-300 text-red-700 rounded-lg text-sm">
                    @Error
                </div>
            }

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Название *</label>
                    <input type="text" @bind="NewEvent.Title" class="w-full rounded-lg border-2 border-pink-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400 focus:border-pink-400" 
                           placeholder="Романтический ужин" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Дата *</label>
                    <input type="date" @bind="NewEvent.Date" class="w-full rounded-lg border-2 border-pink-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400 focus:border-pink-400" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Эмодзи</label>
                    <input type="text" @bind="NewEvent.Emoji" class="w-full rounded-lg border-2 border-pink-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400 focus:border-pink-400" 
                           placeholder="💕" maxlength="2" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Тип события</label>
                    <select @bind="NewEvent.Type" class="w-full rounded-lg border-2 border-pink-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400 focus:border-pink-400">
                        <option value="personal">Личное</option>
                        <option value="romantic">Романтическое</option>
                        <option value="anniversary">Годовщина</option>
                        <option value="birthday">День рождения</option>
                        <option value="holiday">Праздник</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Описание (необязательно)</label>
                    <textarea @bind="NewEvent.Description" class="w-full rounded-lg border-2 border-pink-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400 focus:border-pink-400 resize-none" 
                              rows="3" placeholder="Дополнительные детали..."></textarea>
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <button @onclick="AddEvent" class="flex-1 bg-pink-500 hover:bg-pink-600 text-white py-2 rounded-lg font-semibold transition">
                    Добавить
                </button>
                <button @onclick="() => ShowAddEventModal = false" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 py-2 rounded-lg font-semibold transition">
                    Отмена
                </button>
            </div>
        </div>
    </div>
}