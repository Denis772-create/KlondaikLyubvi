@page "/romance-bank"
@inject HttpClient Http
@inject IJSRuntime JS

<div class="bg-gradient-to-br from-purple-100 via-pink-100 to-rose-200 min-h-screen py-6 px-4 font-sans">
    <div class="max-w-6xl mx-auto bg-white/70 backdrop-blur-md rounded-3xl shadow-xl p-6">
        
        <!-- Заголовок -->
        <div class="flex items-center gap-4 flex-wrap mb-6">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-500 to-pink-500 shadow-lg flex items-center justify-center text-3xl">💝</div>
            <div class="flex-1 min-w-0">
                <div class="text-3xl font-extrabold text-gray-800 mb-2">Банк Романтики</div>
                <div class="text-gray-600 text-base">Обменивайтесь заботой и создавайте особенные моменты вместе</div>
            </div>
        </div>

        <!-- Дашборд -->
        <div class="space-y-6">
            <!-- Уровень любви -->
            <div class="bg-gradient-to-br from-purple-100 to-pink-100 rounded-2xl p-6 border-2 border-purple-200">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-16 h-16 rounded-full bg-gradient-to-br from-purple-500 to-pink-500 flex items-center justify-center text-2xl">👑</div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-800">💕 Начинающие романтики</h3>
                        <p class="text-purple-600 font-semibold">0 очков любви</p>
                    </div>
                </div>
                
                <!-- Прогресс -->
                <div class="mb-4">
                    <div class="flex justify-between text-sm text-gray-600 mb-2">
                        <span>Прогресс до следующего уровня</span>
                        <span>0 / 50</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-3">
                        <div class="bg-gradient-to-r from-purple-500 to-pink-500 h-3 rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
                
                <!-- Быстрые действия -->
                <div class="flex gap-3 flex-wrap">
                    <button class="px-4 py-2 bg-purple-500 hover:bg-purple-600 text-white rounded-lg font-semibold transition">
                        🛍️ Найти услугу
                    </button>
                    <button class="px-4 py-2 bg-pink-500 hover:bg-pink-600 text-white rounded-lg font-semibold transition">
                        💝 Добавить услугу
                    </button>
                </div>
            </div>
            
            <!-- Статистика -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-white rounded-xl p-4 shadow-lg text-center border border-gray-200">
                    <div class="text-2xl font-bold text-purple-600">0</div>
                    <div class="text-sm text-gray-600">Завершенных обменов</div>
                </div>
                <div class="bg-white rounded-xl p-4 shadow-lg text-center border border-gray-200">
                    <div class="text-2xl font-bold text-pink-600">0</div>
                    <div class="text-sm text-gray-600">Всего запросов</div>
                </div>
                <div class="bg-white rounded-xl p-4 shadow-lg text-center border border-gray-200">
                    <div class="text-2xl font-bold text-blue-600">0.0</div>
                    <div class="text-sm text-gray-600">Средняя оценка</div>
                </div>
                <div class="bg-white rounded-xl p-4 shadow-lg text-center border border-gray-200">
                    <div class="text-2xl font-bold text-green-600">0</div>
                    <div class="text-sm text-gray-600">За эту неделю</div>
                </div>
            </div>
            
            <!-- Пустое состояние -->
            <div class="bg-white rounded-2xl p-6 shadow-lg border border-gray-200">
                <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                    📈 Недавняя активность
                </h3>
                <div class="text-center py-8 text-gray-500">
                    <div class="text-4xl mb-2">💫</div>
                    <p>Пока нет активности. Начните с создания первой услуги!</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Простая инициализация без ошибок
        await Task.CompletedTask;
    }
}
