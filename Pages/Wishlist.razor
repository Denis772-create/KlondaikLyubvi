@page "/wishlist"
@inject HttpClient Http
@inject IJSRuntime JS

@code {
    class WishlistItemDto
    {
        public int Id { get; set; }
        public int UserId { get; set; }
        public string Occasion { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
        public string? Title { get; set; }
        public string? Note { get; set; }
        public DateTime CreatedAt { get; set; }
        public string? MetaTitle { get; set; }
        public string? MetaDescription { get; set; }
        public string? MetaImage { get; set; }
        public string? MetaSiteName { get; set; }
        public string? MetaUrl { get; set; }
    }
    List<WishlistItemDto> Items = new();
    int UserId = 0;
    string Occasion = "Любой";
    string Url = string.Empty;
    string? Title = null;
    string? Note = null;
    string? Error = null;
    string? Success = null;

    string FilterOccasion = "all"; // all | birthday | newyear | other
    string Query = string.Empty;
    string Priority = "medium"; // low | medium | high
    
    // Модальное окно
    bool ShowAddModal = false;

    IEnumerable<WishlistItemDto> Filtered
        => Items
            .Where(i => FilterOccasion == "all" || (FilterOccasion == "birthday" ? i.Occasion.Contains("день", StringComparison.OrdinalIgnoreCase) : FilterOccasion == "newyear" ? i.Occasion.Contains("нов", StringComparison.OrdinalIgnoreCase) : true))
            .Where(i => string.IsNullOrWhiteSpace(Query)
                || (i.Title ?? i.MetaTitle ?? string.Empty).Contains(Query, StringComparison.OrdinalIgnoreCase)
                || (i.MetaDescription ?? string.Empty).Contains(Query, StringComparison.OrdinalIgnoreCase)
                || i.Occasion.Contains(Query, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var uid = await JS.InvokeAsync<string>("blazorGetCookie", "userId");
        int.TryParse(uid, out UserId);
        Items = await Http.GetFromJsonAsync<List<WishlistItemDto>>($"/api/wishlist/{UserId}") ?? new();
    }

    void OpenAddModal()
    {
        Url = string.Empty;
        Title = null;
        Note = null;
        Occasion = "Любой";
        Priority = "medium";
        Error = null;
        ShowAddModal = true;
    }

    async Task Add()
    {
        Error = null;
        Success = null;
        if (string.IsNullOrWhiteSpace(Url)) { Error = "Введите ссылку"; return; }
        
        var resp = await Http.PostAsJsonAsync("/api/wishlist", new { userId = UserId, occasion = Occasion, url = Url, title = Title, note = Note, priority = Priority });
        if (resp.IsSuccessStatusCode)
        {
            var item = await resp.Content.ReadFromJsonAsync<WishlistItemDto>();
            if (item != null) 
            {
                Items.Insert(0, item);
                Success = "Желание добавлено!";
                ShowAddModal = false;
            }
        }
        else Error = "Не удалось добавить";
    }

    async Task Delete(int id)
    {
        var resp = await Http.DeleteAsync($"/api/wishlist/{id}");
        if (resp.IsSuccessStatusCode)
        {
            var it = Items.FirstOrDefault(x => x.Id == id);
            if (it != null) Items.Remove(it);
        }
    }

    async Task Refresh(int id)
    {
        await Http.PostAsync($"/api/wishlist/{id}/refresh", null);
        Items = await Http.GetFromJsonAsync<List<WishlistItemDto>>($"/api/wishlist/{UserId}") ?? new();
    }

    string DisplayTitle(WishlistItemDto w)
        => !string.IsNullOrWhiteSpace(w.Title) ? w.Title!
           : !string.IsNullOrWhiteSpace(w.MetaTitle) ? w.MetaTitle!
           : (HostFor(w) ?? w.Url);

    string? HostFor(WishlistItemDto w)
    {
        try { return new Uri(w.MetaUrl ?? w.Url).Host; } catch { return null; }
    }

    string? FaviconFor(WishlistItemDto w)
    {
        try { var u = new Uri(w.MetaUrl ?? w.Url); return $"{u.Scheme}://{u.Host}/favicon.ico"; } catch { return null; }
    }
}

<div class="bg-gradient-to-br from-rose-50 to-pink-100 min-h-screen py-8 px-4 font-sans">
    <div class="max-w-4xl mx-auto bg-white/80 backdrop-blur-md rounded-3xl shadow-2xl p-6">
        <!-- Заголовок и управление -->
        <div class="flex items-center justify-between gap-3 mb-6 flex-wrap">
            <div>
                <h1 class="text-3xl font-extrabold text-pink-600 flex items-center gap-2">
                    <span class="text-4xl">🌟</span> Wishlist
                </h1>
                <p class="text-gray-600 text-sm mt-1">Сохраняйте желания и мечты</p>
            </div>
            <button @onclick="OpenAddModal" class="bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-xl font-semibold transition flex items-center gap-2">
                ➕ Добавить желание
            </button>
        </div>

        <!-- Уведомления -->
        @if (!string.IsNullOrEmpty(Success))
        {
            <div class="mb-4 p-4 bg-green-100 border border-green-300 text-green-700 rounded-xl flex justify-between items-center">
                <span>@Success</span>
                <button @onclick="() => Success = null" class="text-green-500 hover:text-green-700">✕</button>
            </div>
        }

        <!-- Фильтры -->
        <div class="bg-white rounded-2xl shadow-lg p-4 mb-6">
            <div class="flex gap-3 flex-wrap">
                <input class="flex-1 min-w-[200px] rounded-xl border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400" placeholder="Поиск по названию, описанию..." @bind="Query" />
                <select class="rounded-xl border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400" @bind="FilterOccasion">
                    <option value="all">Все поводы</option>
                    <option value="birthday">Дни рождения</option>
                    <option value="newyear">Новый год</option>
                    <option value="other">Другое</option>
                </select>
            </div>
        </div>

        <!-- Список желаний -->
        @if (!Filtered.Any())
        {
            <div class="text-center py-12 bg-white/60 rounded-2xl">
                <div class="text-6xl mb-4">🌟</div>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">Список желаний пуст</h3>
                <p class="text-gray-500 mb-4">Добавьте первое желание!</p>
                <button @onclick="OpenAddModal" class="px-4 py-2 bg-pink-500 hover:bg-pink-600 text-white rounded-xl font-semibold transition">
                    ➕ Добавить желание
                </button>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            @foreach (var w in Filtered)
            {
                <div class="rounded-2xl overflow-hidden shadow group bg-gradient-to-br from-pink-50 to-rose-50 border border-pink-100">
                    @if (!string.IsNullOrEmpty(w.MetaImage))
                    {
                        <div class="h-40 w-full bg-gray-100 overflow-hidden">
                            <img src="@w.MetaImage" alt="preview" class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform" />
                        </div>
                    }
                    <div class="p-4 flex flex-col gap-2">
                        <div class="text-xs text-pink-500 font-bold">@w.Occasion</div>
                        <a href="@(w.MetaUrl ?? w.Url)" target="_blank" class="text-lg font-extrabold text-gray-800 hover:text-pink-600 line-clamp-2 flex items-center gap-2">
                            @if (!string.IsNullOrEmpty(FaviconFor(w)))
                            {
                                <img src="@FaviconFor(w)" alt="icon" class="w-5 h-5 rounded-sm" />
                            }
                            @DisplayTitle(w)
                        </a>
                        @if (!string.IsNullOrEmpty(w.MetaDescription))
                        {
                            <div class="text-sm text-gray-600 line-clamp-3">@w.MetaDescription</div>
                        }
                        @if (!string.IsNullOrEmpty(w.Note))
                        {
                            <div class="text-sm text-gray-500">📝 @w.Note</div>
                        }
                        <div class="flex items-center justify-between pt-2">
                            <span class="text-xs text-gray-400">@w.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                            <div class="flex items-center gap-2">
                                <button class="text-xs px-3 py-1 rounded-full bg-white border border-pink-200 hover:bg-pink-50" title="Обновить превью" @onclick="() => Refresh(w.Id)">Обновить</button>
                                <button class="text-xs px-3 py-1 rounded-full bg-red-50 text-red-600 border border-red-200 hover:bg-red-100" title="Удалить" @onclick="() => Delete(w.Id)">Удалить</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            </div>
        }
    </div>
</div>

<!-- Модальное окно добавления желания -->
@if (ShowAddModal)
{
    <div class="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50" @onclick="() => ShowAddModal = false">
        <div class="bg-white rounded-2xl p-6 max-w-md w-full max-h-[90vh] overflow-y-auto" @onclick:stopPropagation="true">
            <h3 class="text-xl font-bold text-gray-800 mb-4">Добавить желание</h3>
            
            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="mb-4 p-3 bg-red-100 border border-red-300 text-red-700 rounded-lg text-sm">
                    @Error
                </div>
            }

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Ссылка *</label>
                    <input type="url" @bind="Url" class="w-full rounded-lg border-2 border-pink-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400 focus:border-pink-400" 
                           placeholder="https://example.com/product" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Повод</label>
                    <select @bind="Occasion" class="w-full rounded-lg border-2 border-pink-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400 focus:border-pink-400">
                        <option value="Любой">Любой повод</option>
                        <option value="День рождения">День рождения</option>
                        <option value="Новый год">Новый год</option>
                        <option value="8 марта">8 марта</option>
                        <option value="14 февраля">14 февраля</option>
                        <option value="Годовщина">Годовщина</option>
                        <option value="Просто так">Просто так</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Приоритет</label>
                    <select @bind="Priority" class="w-full rounded-lg border-2 border-pink-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400 focus:border-pink-400">
                        <option value="low">🟢 Низкий</option>
                        <option value="medium">🟡 Средний</option>
                        <option value="high">🔴 Высокий</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Название (необязательно)</label>
                    <input type="text" @bind="Title" class="w-full rounded-lg border-2 border-pink-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400 focus:border-pink-400" 
                           placeholder="Красивое платье" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Заметка (необязательно)</label>
                    <textarea @bind="Note" class="w-full rounded-lg border-2 border-pink-200 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-pink-400 focus:border-pink-400 resize-none" 
                              rows="3" placeholder="Дополнительные пожелания..."></textarea>
                </div>
            </div>

            <div class="flex gap-3 mt-6">
                <button @onclick="Add" class="flex-1 bg-pink-500 hover:bg-pink-600 text-white py-2 rounded-lg font-semibold transition">
                    Добавить
                </button>
                <button @onclick="() => ShowAddModal = false" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 py-2 rounded-lg font-semibold transition">
                    Отмена
                </button>
            </div>
        </div>
    </div>
}

<style>
.line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>


