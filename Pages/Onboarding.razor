@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="fixed inset-0 bg-gradient-to-br from-purple-900 via-pink-800 to-rose-900 z-50 overflow-hidden">
    <!-- Анимированный фон -->
    <div class="absolute inset-0">
        <div class="floating-hearts">
            @for (int i = 0; i < 15; i++)
            {
                <div class="heart heart-@i">💕</div>
            }
        </div>
        <div class="floating-sparkles">
            @for (int i = 0; i < 20; i++)
            {
                <div class="sparkle sparkle-@i">✨</div>
            }
        </div>
    </div>

    <!-- Контент онбординга -->
    <div class="relative z-10 min-h-screen flex items-center justify-center p-4">
        <div class="max-w-4xl mx-auto text-center">
            
            @if (CurrentStep == 1)
            {
                <!-- Шаг 1: Добро пожаловать -->
                <div class="welcome-step animate-fade-in">
                    <div class="mb-8">
                        <div class="text-8xl mb-6 animate-bounce-slow">💝</div>
                        <h1 class="text-5xl md:text-7xl font-extrabold text-white mb-4 drop-shadow-lg">
                            Добро пожаловать
                        </h1>
                        <h2 class="text-2xl md:text-3xl text-pink-200 mb-8">
                            в ваше личное романтическое пространство!
                        </h2>
                    </div>
                    
                    <div class="bg-white/10 backdrop-blur-md rounded-3xl p-8 mb-8 border border-white/20">
                        <p class="text-xl text-white/90 leading-relaxed">
                            Здесь вы можете делиться признаниями в любви, создавать совместные воспоминания, 
                            планировать романтические встречи и многое другое!
                        </p>
                    </div>
                    
                    <button @onclick="NextStep" class="btn-primary">
                        <span class="text-2xl mr-2">🚀</span>
                        Начать путешествие
                    </button>
                </div>
            }
            
            @if (CurrentStep == 2)
            {
                <!-- Шаг 2: Возможности -->
                <div class="features-step animate-slide-in">
                    <h2 class="text-4xl md:text-5xl font-bold text-white mb-8">
                        Что вас ждет?
                    </h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                        <div class="feature-card" style="animation-delay: 0.1s">
                            <div class="text-5xl mb-4">📝</div>
                            <h3 class="text-xl font-bold text-white mb-2">Признания в любви</h3>
                            <p class="text-pink-200">Делитесь чувствами каждый день</p>
                        </div>
                        
                        <div class="feature-card" style="animation-delay: 0.2s">
                            <div class="text-5xl mb-4">📸</div>
                            <h3 class="text-xl font-bold text-white mb-2">Галерея воспоминаний</h3>
                            <p class="text-pink-200">Сохраняйте особенные моменты</p>
                        </div>
                        
                        <div class="feature-card" style="animation-delay: 0.3s">
                            <div class="text-5xl mb-4">💝</div>
                            <h3 class="text-xl font-bold text-white mb-2">Банк романтики</h3>
                            <p class="text-pink-200">Обменивайтесь заботой и вниманием</p>
                        </div>
                        
                        <div class="feature-card" style="animation-delay: 0.4s">
                            <div class="text-5xl mb-4">🎟️</div>
                            <h3 class="text-xl font-bold text-white mb-2">Приглашения</h3>
                            <p class="text-pink-200">Планируйте романтические встречи</p>
                        </div>
                        
                        <div class="feature-card" style="animation-delay: 0.5s">
                            <div class="text-5xl mb-4">🌟</div>
                            <h3 class="text-xl font-bold text-white mb-2">Список желаний</h3>
                            <p class="text-pink-200">Мечтайте и воплощайте мечты</p>
                        </div>
                        
                        <div class="feature-card" style="animation-delay: 0.6s">
                            <div class="text-5xl mb-4">📅</div>
                            <h3 class="text-xl font-bold text-white mb-2">Календарь любви</h3>
                            <p class="text-pink-200">Важные даты и события</p>
                        </div>
                    </div>
                    
                    <div class="flex gap-4 justify-center">
                        <button @onclick="PrevStep" class="btn-secondary">
                            ← Назад
                        </button>
                        <button @onclick="NextStep" class="btn-primary">
                            Продолжить →
                        </button>
                    </div>
                </div>
            }
            
            @if (CurrentStep == 3)
            {
                <!-- Шаг 3: Персонализация -->
                <div class="personalization-step animate-slide-in">
                    <h2 class="text-4xl md:text-5xl font-bold text-white mb-8">
                        Давайте знакомиться!
                    </h2>
                    
                    <div class="bg-white/10 backdrop-blur-md rounded-3xl p-8 mb-8 border border-white/20 max-w-2xl mx-auto">
                        <div class="mb-6">
                            <div class="text-6xl mb-4">
                                @(UserName == "Денис" ? "🧔" : UserName == "Лиза" ? "👩" : "👤")
                            </div>
                            <h3 class="text-2xl font-bold text-white mb-4">
                                Привет, @UserName! 👋
                            </h3>
                        </div>
                        
                        <div class="space-y-4 text-left">
                            <div class="flex items-center gap-3 text-white/90">
                                <span class="text-2xl">💡</span>
                                <span>Создавайте признания в любви каждый день</span>
                            </div>
                            <div class="flex items-center gap-3 text-white/90">
                                <span class="text-2xl">🎯</span>
                                <span>Зарабатывайте очки романтики за активность</span>
                            </div>
                            <div class="flex items-center gap-3 text-white/90">
                                <span class="text-2xl">🏆</span>
                                <span>Открывайте новые уровни отношений</span>
                            </div>
                            <div class="flex items-center gap-3 text-white/90">
                                <span class="text-2xl">💌</span>
                                <span>Получайте уведомления о новых сюрпризах</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="flex gap-4 justify-center">
                        <button @onclick="PrevStep" class="btn-secondary">
                            ← Назад
                        </button>
                        <button @onclick="NextStep" class="btn-primary">
                            Готов начать! 🎉
                        </button>
                    </div>
                </div>
            }
            
            @if (CurrentStep == 4)
            {
                <!-- Шаг 4: Финал -->
                <div class="final-step animate-zoom-in">
                    <div class="text-8xl mb-6 animate-pulse">🎉</div>
                    <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
                        Все готово!
                    </h2>
                    <p class="text-xl text-pink-200 mb-8 max-w-2xl mx-auto">
                        Ваше романтическое путешествие начинается прямо сейчас. 
                        Создавайте воспоминания, делитесь любовью и наслаждайтесь каждым моментом вместе!
                    </p>
                    
                    <div class="bg-white/10 backdrop-blur-md rounded-3xl p-6 mb-8 border border-white/20 max-w-md mx-auto">
                        <div class="text-3xl mb-2">💝</div>
                        <p class="text-white font-semibold">Первый совет:</p>
                        <p class="text-pink-200 text-sm">Начните с создания первого признания в любви!</p>
                    </div>
                    
                    <button @onclick="CompleteOnboarding" class="btn-primary text-xl px-8 py-4">
                        <span class="text-2xl mr-2">🚀</span>
                        Войти в приложение
                    </button>
                </div>
            }
            
            <!-- Индикатор прогресса -->
            <div class="fixed bottom-8 left-1/2 transform -translate-x-1/2">
                <div class="flex gap-2">
                    @for (int i = 1; i <= 4; i++)
                    {
                        <div class="w-3 h-3 rounded-full transition-all duration-300 @(i <= CurrentStep ? "bg-white" : "bg-white/30")"></div>
                    }
                </div>
                <div class="text-center mt-2 text-white/70 text-sm">
                    @CurrentStep из 4
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .animate-fade-in {
        animation: fadeIn 0.8s ease-out;
    }
    
    .animate-slide-in {
        animation: slideIn 0.6s ease-out;
    }
    
    .animate-zoom-in {
        animation: zoomIn 0.8s ease-out;
    }
    
    .animate-bounce-slow {
        animation: bounceSlow 2s ease-in-out infinite;
    }
    
    .btn-primary {
        background: linear-gradient(135deg, #ec4899, #f97316);
        color: white;
        padding: 1rem 2rem;
        border-radius: 1rem;
        font-weight: bold;
        font-size: 1.1rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(236, 72, 153, 0.4);
    }
    
    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(236, 72, 153, 0.6);
    }
    
    .btn-secondary {
        background: rgba(255, 255, 255, 0.1);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        border: 1px solid rgba(255, 255, 255, 0.2);
        cursor: pointer;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }
    
    .btn-secondary:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: translateY(-1px);
    }
    
    .feature-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1.5rem;
        padding: 2rem;
        text-align: center;
        transition: all 0.3s ease;
        animation: fadeInUp 0.6s ease-out both;
    }
    
    .feature-card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.15);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }
    
    .floating-hearts {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        pointer-events: none;
    }
    
    .heart {
        position: absolute;
        font-size: 1.5rem;
        animation: float 6s ease-in-out infinite;
        opacity: 0.6;
    }
    
    .floating-sparkles {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        pointer-events: none;
    }
    
    .sparkle {
        position: absolute;
        font-size: 1rem;
        animation: sparkle 4s ease-in-out infinite;
        opacity: 0.8;
    }
    
    /* Фиксированные позиции для анимированных элементов уже определены ниже */
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @@keyframes slideIn {
        from { opacity: 0; transform: translateX(-50px); }
        to { opacity: 1; transform: translateX(0); }
    }
    
    @@keyframes zoomIn {
        from { opacity: 0; transform: scale(0.8); }
        to { opacity: 1; transform: scale(1); }
    }
    
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    @@keyframes bounceSlow {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
    
    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        25% { transform: translateY(-20px) rotate(5deg); }
        50% { transform: translateY(-10px) rotate(-5deg); }
        75% { transform: translateY(-15px) rotate(3deg); }
    }
    
    @@keyframes sparkle {
        0%, 100% { opacity: 0.3; transform: scale(0.8); }
        50% { opacity: 1; transform: scale(1.2); }
    }
    
    /* Фиксированные позиции для анимированных элементов */
    .heart-0 { left: 10%; top: 20%; animation-delay: 0s; }
    .heart-1 { left: 85%; top: 15%; animation-delay: 1s; }
    .heart-2 { left: 70%; top: 80%; animation-delay: 2s; }
    .heart-3 { left: 20%; top: 70%; animation-delay: 3s; }
    .heart-4 { left: 90%; top: 50%; animation-delay: 4s; }
    .heart-5 { left: 5%; top: 90%; animation-delay: 5s; }
    .heart-6 { left: 50%; top: 5%; animation-delay: 0.5s; }
    .heart-7 { left: 30%; top: 40%; animation-delay: 1.5s; }
    .heart-8 { left: 75%; top: 25%; animation-delay: 2.5s; }
    .heart-9 { left: 15%; top: 60%; animation-delay: 3.5s; }
    .heart-10 { left: 95%; top: 75%; animation-delay: 4.5s; }
    .heart-11 { left: 40%; top: 85%; animation-delay: 0.8s; }
    .heart-12 { left: 60%; top: 10%; animation-delay: 1.8s; }
    .heart-13 { left: 25%; top: 30%; animation-delay: 2.8s; }
    .heart-14 { left: 80%; top: 60%; animation-delay: 3.8s; }
    
    .sparkle-0 { left: 15%; top: 25%; animation-delay: 0s; }
    .sparkle-1 { left: 80%; top: 20%; animation-delay: 0.5s; }
    .sparkle-2 { left: 65%; top: 75%; animation-delay: 1s; }
    .sparkle-3 { left: 25%; top: 65%; animation-delay: 1.5s; }
    .sparkle-4 { left: 85%; top: 45%; animation-delay: 2s; }
    .sparkle-5 { left: 10%; top: 85%; animation-delay: 2.5s; }
    .sparkle-6 { left: 45%; top: 10%; animation-delay: 3s; }
    .sparkle-7 { left: 35%; top: 35%; animation-delay: 0.3s; }
    .sparkle-8 { left: 70%; top: 30%; animation-delay: 0.8s; }
    .sparkle-9 { left: 20%; top: 55%; animation-delay: 1.3s; }
    .sparkle-10 { left: 90%; top: 70%; animation-delay: 1.8s; }
    .sparkle-11 { left: 35%; top: 80%; animation-delay: 2.3s; }
    .sparkle-12 { left: 55%; top: 15%; animation-delay: 2.8s; }
    .sparkle-13 { left: 30%; top: 25%; animation-delay: 3.3s; }
    .sparkle-14 { left: 75%; top: 55%; animation-delay: 0.2s; }
    .sparkle-15 { left: 12%; top: 45%; animation-delay: 0.7s; }
    .sparkle-16 { left: 88%; top: 35%; animation-delay: 1.2s; }
    .sparkle-17 { left: 42%; top: 70%; animation-delay: 1.7s; }
    .sparkle-18 { left: 68%; top: 85%; animation-delay: 2.2s; }
    .sparkle-19 { left: 22%; top: 15%; animation-delay: 2.7s; }
</style>

@code {
    [Parameter] public string UserName { get; set; } = "";
    [Parameter] public EventCallback OnComplete { get; set; }
    
    private int CurrentStep = 1;
    
    private void NextStep()
    {
        if (CurrentStep < 4)
        {
            CurrentStep++;
            StateHasChanged();
        }
    }
    
    private void PrevStep()
    {
        if (CurrentStep > 1)
        {
            CurrentStep--;
            StateHasChanged();
        }
    }
    
    private async Task CompleteOnboarding()
    {
        // Сохраняем флаг завершения онбординга
        await JS.InvokeVoidAsync("blazorSetCookie", "onboardingCompleted", "true", 365);
        
        // Вызываем callback для завершения
        await OnComplete.InvokeAsync();
    }
}
